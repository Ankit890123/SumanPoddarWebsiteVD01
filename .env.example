# =============================================================================
# tecnosra - Suman Poddar Portfolio & Production House Backend Configuration
# =============================================================================

# Flask Server Configuration
FLASK_ENV=production
FLASK_PORT=5000
FLASK_DEBUG=False
SECRET_KEY=your_generated_secret_key_here

# Admin API Key (For accessing GET /api/contact/inquiries)
ADMIN_API_KEY=tsra_admin_secret_key_change_me

# Contact Notification Receiver Email
CONTACT_RECEIVER_EMAIL=technosra26@gmail.com

# SMTP Email Dispatcher (For automatic notification upon new client inquiry)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=technosra26@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here

# Resend Email API Key (Alternative modern transactional email API - https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here

# Instant Alert Webhooks (Optional for instant notifications on phone)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Gemini AI API Key (For automatic project brief summarization & estimation)
GEMINI_API_KEY=your_gemini_api_key_here
